# Variables de despliegue; no se cargan automáticamente desde este archivo.
# Exportarlas en el host o configurarlas en su panel.
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/aura
STORAGE_DIR=/data/captures
PUBLIC_ORIGIN=https://tu-dominio.example
SECURE_COOKIES=true
PORT=8000

# Cookie anónima: 30 días; se renueva al abrir la web antes de caducar.
AURA_SESSION_HOURS=720
# Railway: PUBLIC_ORIGIN puede omitirse si RAILWAY_PUBLIC_DOMAIN está disponible.
